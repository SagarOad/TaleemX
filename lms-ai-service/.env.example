# ── Copy this file to .env and fill in real values ───────────────────────────
# NEVER commit .env to version control.

# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Flash is the primary model: fast and accurate enough for grounded SQL gen.
# Pro is used as a fallback for hard cases.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.5-flash-lite
GEMINI_MAX_RETRIES=1
# 0.5s = paid tier safe. Set to 6.5 if on the free tier.
GEMINI_MIN_CALL_INTERVAL_SECONDS=0.5
GEMINI_429_COOLDOWN_SECONDS=20
# Per-call HTTP timeout. Keep short so a slow model fails fast and we move
# to the next fallback.
GEMINI_REQUEST_TIMEOUT_SECONDS=25
# Used for short latency-sensitive calls (plan, critic, format).
GEMINI_FAST_MODEL=gemini-2.5-flash
GUNICORN_WORKERS=1
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── RapidAPI (YouTube caption/transcript extraction) ────────────────────────
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=youtube-captions-transcript-subtitles-video-combiner.p.rapidapi.com
RAPIDAPI_URL_TEMPLATE=https://youtube-captions-transcript-subtitles-video-combiner.p.rapidapi.com/download-webvtt/{video_id}
RAPIDAPI_RESPONSE_MODE=default
RAPIDAPI_TIMEOUT_SECONDS=30
RAPIDAPI_YT_LANG=en
RAPIDAPI_YT_CHUNK_SIZE=500
RAPIDAPI_YT_TEXT_MODE=false

# ── MySQL — read-only user credentials ──────────────────────────────────────
# Docker Compose: use service name. Host-only dev: DB_HOST=127.0.0.1 and DB_PORT=3307.
DB_HOST=lms-mysql
DB_PORT=3306
DB_USER=lms_readonly
DB_PASSWORD=your_db_password_here
DB_NAME=lms_db

# If your LMS MySQL is an external server, replace DB_HOST with the real host
# and remove or comment out the lms-mysql service from docker-compose.yml.

# MySQL root password (only needed if using the bundled MySQL container)
MYSQL_ROOT_PASSWORD=changeme_root_password

# Tuning
DB_QUERY_TIMEOUT=15        # seconds
DB_MAX_ROWS=50

# ── RAG / Vector store ──────────────────────────────────────────────────────
# 'gemini' uses Google text-embedding-004 (recommended; reuses GEMINI_API_KEY).
# 'local' falls back to ONNX all-MiniLM-L6-v2 (offline-capable, ~80 MB on first use).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_GEMINI=text-embedding-004

# Where Chroma persists its embeddings on disk (mount as a Docker volume).
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_QA_COLLECTION=lms_qa_pairs
CHROMA_SCHEMA_COLLECTION=lms_table_cards

# Bootstrap data files (curated examples + table descriptions).
QA_PAIRS_FILE=/app/data/qa_pairs.jsonl
# Business / school-performance few-shot examples (upserted on every boot)
QA_PAIRS_EXTRA_FILES=/app/data/qa_pairs_business.jsonl
TABLE_HINTS_FILE=/app/data/table_purpose_hints.json

# Retrieval depth.
QA_TOP_K=8
SCHEMA_TOP_K=8
# If the nearest curated QA example is within this cosine distance of the
# user's question we skip the LLM entirely and use the curated SQL.
# 0.18 ≈ similarity 0.82 (close paraphrase). Lower = stricter.
QA_TRUST_MATCH_DISTANCE=0.18
# Learned pairs (added via 👍 feedback) use a STRICTER threshold than curated
# pairs — only near-identical paraphrases get the fast-path.
QA_LEARNED_TRUST_DISTANCE=0.10
# How long the /ask → 👍/👎 feedback window stays open per request_id.
FEEDBACK_CACHE_TTL_SECONDS=3600
LEARNED_QA_FILE=/app/data/qa_pairs_learned.jsonl
CHROMA_LEARNED_COLLECTION=lms_qa_learned

# Auto-seed collections on first boot (idempotent).
AUTO_SEED_QA=true
AUTO_SEED_SCHEMA=true

# ── Agent loop ──────────────────────────────────────────────────────────────
# Default path: retrieve → generate SQL → execute → respond (one LLM call total).
# Turn AGENT_ENABLE_PLAN / CRITIC on for higher accuracy at the cost of latency.
AGENT_MAX_ITERATIONS=2
AGENT_ENABLE_PLAN=false
AGENT_ENABLE_CRITIC=false
AGENT_PLAN_TEMPERATURE=0.1
AGENT_SQL_TEMPERATURE=0.0
AGENT_CRITIC_TEMPERATURE=0.0

# ── Whisper ─────────────────────────────────────────────────────────────────
# tiny | base | small | medium | large
# tiny  ~  75M params, ~1 GB RAM
# base  ~ 150M params, ~1.5 GB RAM
# small ~ 450M params, ~2 GB RAM
WHISPER_MODEL=base

# Upload storage path inside the container
UPLOAD_FOLDER=/tmp/lms_uploads
