# ---------- Local dev URLs (reference only) ----------
# LMS in browser:  http://localhost:${PHP_PORT:-8080}/
# AI test UI:     http://localhost:${AI_PORT:-5050}/
# If PHP runs on your host (not Docker), config defaults use 127.0.0.1:${AI_PORT:-5050} for Ask AI / caption / subtitles.
# Docker Compose sets ASKAI_API_URL etc. on taleemx-php to http://lms-ai-service:5000/... automatically.

# ---------- Local ports ----------
PHP_PORT=8080
AI_PORT=5050
MYSQL_PORT=3307

# ---------- Shared database ----------
DB_HOST=lms-mysql
DB_PORT=3306
DB_USER=lms_readonly
DB_PASSWORD=change_me_db_password
DB_NAME=lms_db
MYSQL_ROOT_PASSWORD=change_me_root_password

# ---------- AI service ----------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_RETRIES=1
GEMINI_MIN_CALL_INTERVAL_SECONDS=6.5
GEMINI_429_COOLDOWN_SECONDS=20
GUNICORN_WORKERS=1

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=youtube-transcripts.p.rapidapi.com
RAPIDAPI_TIMEOUT_SECONDS=30
RAPIDAPI_YT_LANG=en
RAPIDAPI_YT_CHUNK_SIZE=500
RAPIDAPI_YT_TEXT_MODE=false

DB_QUERY_TIMEOUT=15
DB_MAX_ROWS=50
WHISPER_MODEL=base
UPLOAD_FOLDER=/tmp/lms_uploads
